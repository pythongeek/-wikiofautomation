# Wiki of Automation — Astro env (Hostinger hPanel → Web App → Environment)
# Copy this file to .env for local dev. For Hostinger production, paste each
# variable into hPanel → Web Apps → (your app) → Settings → Environment.
#
# Generated 2026-07-21 after T009.

# ── Admin auth (T009) ─────────────────────────────────────────────────────────
# Required for /admin/* to work. Generate hash with:
#   npm run seed-admin -- your@email.com 'YourStrongPassword!'   (local)
# or use the helper: scripts/hostinger-env-prep.sh
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# ── Database (T009) ───────────────────────────────────────────────────────────
# Where better-sqlite3 writes admin.db. Use /tmp on Hostinger (writable).
DB_PATH=/tmp/admin.db

# ── Ada AI (T010 — placeholder until shipped) ────────────────────────────────
# Default is set in src/lib/env.ts. Override here when T010 is wired.
LLM_MODEL=minimax/MiniMax-M3
LLM_API_URL=
LLM_API_KEY=

# ── Site URL ──────────────────────────────────────────────────────────────────
SITE_URL=https://wikiofautomation.com
PUBLIC_SITE_URL=https://wikiofautomation.com

# ── Hostinger-supplied (don't set these; hPanel assigns at runtime) ──────────
# NODE_ENV=production
# HOST=0.0.0.0
# PORT=<assigned-by-hpanel>