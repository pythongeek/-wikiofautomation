ADMIN_PASSWORD_HASH=

# Database
DB_PATH=./data/admin.db

# Ada / LLM (T010)
LLM_MODEL=minimax/MiniMax-M3
LLM_API_URL=
LLM_API_KEY=

# Site
SITE_URL=https://wikiofautomation.com
PUBLIC_SITE_URL=https://wikiofautomation.com