---
/**
 * /wiki/[category]/[slug] — single wiki entry page
 * Renders MDX content with an infobox sidebar + sources list.
 */
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '~/layouts/Base.astro';

export async function getStaticPaths() {
  const entries = await getCollection('wiki');
  return entries.map((entry: CollectionEntry<'wiki'>) => ({
    params: { category: entry.data.category, slug: entry.slug },
    props: { entry },
  }));
}

interface Props { entry: CollectionEntry<'wiki'>; }
const { entry } = Astro.props;
const { Content } = await entry.render();

const ib = entry.data.infobox ?? {};
const ibRows = Object.entries(ib).filter(([, v]) => v !== undefined && v !== '');
---

<Base
  title={entry.data.title}
  description={entry.data.summary ?? `${entry.data.title} — wiki of automation`}
>
  <article class="wiki-entry">
    <header class="entry-header">
      <div class="breadcrumb">
        <a href="/wiki">Wiki</a> · <a href={`/wiki/${entry.data.category}`}>{entry.data.category}</a>
      </div>
      <h1>{entry.data.title}</h1>
      {entry.data.summary && <p class="summary">{entry.data.summary}</p>}
    </header>

    <div class="entry-grid">
      <main class="entry-body">
        <Content />
      </main>

      <aside class="entry-aside">
        <div class="infobox">
          <div class="info-head">Infobox</div>
          <dl>
            {ibRows.map(([k, v]) => (
              <div class="row">
                <dt>{k.replace(/_/g, ' ')}</dt>
                <dd>{k === 'repo' || k === 'site'
                    ? <a href={String(v)} target="_blank" rel="noopener">{String(v)}</a>
                    : String(v)}</dd>
              </div>
            ))}
          </dl>
        </div>

        {entry.data.sources.length > 0 && (
          <div class="sources">
            <div class="info-head">Sources</div>
            <ul>
              {entry.data.sources.map((s: { title: string; url: string }) => (
                <li><a href={s.url} target="_blank" rel="noopener">{s.title}</a></li>
              ))}
            </ul>
          </div>
        )}

        <div class="meta">
          <span>Last updated <strong>{entry.data.updated}</strong></span>
        </div>
      </aside>
    </div>
  </article>
</Base>

<style>
  .wiki-entry {
    max-width: var(--max-content);
    margin: 0 auto;
    padding: calc(var(--nav-height) + 60px) 36px 100px;
  }
  .entry-header {
    margin-bottom: 36px;
  }
  .breadcrumb {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .breadcrumb a {
    color: var(--cyan);
  }
  h1 {
    font-size: clamp(34px, 5vw, 52px);
    line-height: 1.1;
    margin-top: 12px;
    margin-bottom: 14px;
  }
  .summary {
    color: var(--muted);
    font-size: 18px;
    line-height: 1.5;
    max-width: 720px;
  }
  .entry-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    gap: 48px;
    align-items: start;
  }
  @media (max-width: 900px) {
    .entry-grid { grid-template-columns: 1fr; }
  }
  .entry-body :global(h2) {
    font-size: 22px;
    margin-top: 36px;
    margin-bottom: 12px;
    padding-top: 12px;
    border-top: 1px solid var(--border);
  }
  .entry-body :global(h3) {
    font-size: 17px;
    margin-top: 24px;
    margin-bottom: 8px;
  }
  .entry-body :global(p) {
    color: var(--text);
    font-size: 15.5px;
    line-height: 1.7;
    margin-bottom: 14px;
  }
  .entry-body :global(ul),
  .entry-body :global(ol) {
    padding-left: 22px;
    margin-bottom: 18px;
    color: var(--text);
  }
  .entry-body :global(li) {
    font-size: 15px;
    line-height: 1.7;
    margin-bottom: 6px;
  }
  .entry-body :global(code) {
    background: var(--surface);
    padding: 2px 7px;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 13.5px;
    color: var(--cyan);
  }
  .entry-body :global(pre) {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 16px;
    overflow-x: auto;
    font-size: 13px;
  }
  .entry-body :global(blockquote) {
    border-left: 2px solid var(--lime);
    padding: 4px 14px;
    color: var(--muted);
    font-style: italic;
    margin: 16px 0;
  }
  .entry-body :global(a) {
    color: var(--cyan);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .entry-body :global(a:hover) {
    color: var(--lime);
  }
  .entry-aside {
    position: sticky;
    top: calc(var(--nav-height) + 24px);
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .infobox,
  .sources {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .info-head {
    background: var(--bg-2);
    padding: 8px 14px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    border-bottom: 1px solid var(--border);
  }
  .infobox dl {
    padding: 4px 0;
  }
  .infobox .row {
    display: grid;
    grid-template-columns: 0.45fr 1fr;
    gap: 8px;
    padding: 8px 14px;
    border-bottom: 1px solid var(--border);
    font-size: 13px;
  }
  .infobox .row:last-child {
    border-bottom: none;
  }
  .infobox dt {
    color: var(--muted-2);
    text-transform: capitalize;
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.04em;
  }
  .infobox dd {
    color: var(--text);
    word-break: break-word;
  }
  .infobox dd a {
    color: var(--cyan);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .sources ul {
    list-style: none;
    padding: 10px 14px;
  }
  .sources li {
    padding: 6px 0;
    border-bottom: 1px solid var(--border);
    font-size: 13px;
  }
  .sources li:last-child { border-bottom: none; }
  .sources a {
    color: var(--cyan);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .meta {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
    text-align: center;
    padding-top: 8px;
  }
  .meta strong { color: var(--text); }
</style>
