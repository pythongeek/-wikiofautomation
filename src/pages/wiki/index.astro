---
/**
 * /wiki — index of all wiki entries, grouped by category
 */
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '~/layouts/Base.astro';

type Wiki = CollectionEntry<'wiki'>;
const all = await getCollection('wiki');
const byCategory: Record<string, Wiki[]> = {};
for (const entry of all) {
  const c = entry.data.category;
  if (!byCategory[c]) byCategory[c] = [];
  byCategory[c]!.push(entry);
}
// sort each category by title
for (const c of Object.keys(byCategory)) {
  byCategory[c]!.sort((a, b) => a.data.title.localeCompare(b.data.title));
}

const categoryLabels: Record<string, string> = {
  agents: 'Agents',
  frameworks: 'Frameworks',
  protocols: 'Protocols',
  models: 'Models',
  companies: 'Companies',
  concepts: 'Concepts',
};
---

<Base
  title="The Encyclopedia of Automation"
  description="Reference entries on every agent, framework, protocol, model, and concept shaping the automation economy."
>
  <div class="page-hero">
    <div class="eyebrow eyebrow-row">
      <span class="dot"></span>
      <span>THE WIKI · {all.length} ENTRIES</span>
    </div>
    <h1>The encyclopedia of automation</h1>
    <p class="lead">Reference-grade documentation for every agent, framework, protocol, model, and concept shaping the automation economy. Source-cited, kept current.</p>
  </div>

  <section class="wiki-index">
    {Object.keys(byCategory).sort().map(cat => (
      <div class="cat-block">
        <h2 class="cat-title">{categoryLabels[cat] ?? cat}</h2>
        <ul class="entry-list">
          {byCategory[cat]!.map(entry => (
            <li>
              <a href={`/wiki/${entry.data.category}/${entry.slug}`}>
                <span class="entry-title">{entry.data.title}</span>
                {entry.data.summary && <span class="entry-summary">{entry.data.summary}</span>}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}

    {all.length === 0 && (
      <div class="empty">
        <p>The wiki is just getting started. We're seeding the highest-value entries first.</p>
      </div>
    )}
  </section>
</Base>

<style>
  .page-hero {
    max-width: var(--max-content);
    margin: 0 auto;
    padding: calc(var(--nav-height) + 80px) 36px 60px;
  }
  .eyebrow-row {
    margin-bottom: 22px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .eyebrow-row .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--mint);
    box-shadow: 0 0 8px var(--mint);
    animation: blink 1.8s infinite;
  }
  @keyframes blink { 0%,100%{opacity:1;} 50%{opacity:.3;} }
  h1 {
    font-size: clamp(34px, 5vw, 56px);
    line-height: 1.05;
    margin-bottom: 16px;
  }
  .lead {
    color: var(--muted);
    font-size: 18px;
    max-width: 640px;
    line-height: 1.55;
  }
  section.wiki-index {
    max-width: var(--max-content);
    margin: 0 auto;
    padding: 40px 36px 100px;
  }
  .cat-block {
    margin-bottom: 48px;
  }
  .cat-title {
    font-size: 22px;
    margin-bottom: 16px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border);
    color: var(--lime);
    font-family: var(--font-mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: 14px;
  }
  .entry-list {
    list-style: none;
  }
  .entry-list li a {
    display: block;
    padding: 14px 0;
    border-bottom: 1px solid var(--border);
    color: inherit;
    transition: padding 0.15s;
  }
  .entry-list li a:hover {
    padding-left: 8px;
    color: var(--lime);
  }
  .entry-title {
    font-size: 17px;
    font-weight: 500;
    display: block;
  }
  .entry-summary {
    font-size: 13.5px;
    color: var(--muted);
    margin-top: 4px;
    display: block;
  }
  .empty {
    text-align: center;
    padding: 60px;
    color: var(--muted);
    background: var(--surface);
    border: 1px dashed var(--border);
    border-radius: var(--radius);
  }
</style>
