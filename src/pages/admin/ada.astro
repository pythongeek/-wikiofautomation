---
import Layout from '@/layouts/Base.astro';
export const prerender = false;

import { db } from '@/lib/db';
import { ada_queries } from '@/lib/db/schema';
import { desc, count, sql } from 'drizzle-orm';

const session = Astro.locals.session;
if (!session) return Astro.redirect('/admin/login');

const page = Math.max(1, Number(Astro.url.searchParams.get('page')) || 1);
const PAGE_SIZE = 25;
const offset = (page - 1) * PAGE_SIZE;

const queries = await db
  .select()
  .from(ada_queries)
  .orderBy(desc(ada_queries.created_at))
  .limit(PAGE_SIZE)
  .offset(offset);

const [{ total }] = await db.select({ total: count() }).from(ada_queries);

const topIntents = await db
  .select({
    intent: ada_queries.intent,
    c: sql<number>`COUNT(*)`,
  })
  .from(ada_queries)
  .where(sql`${ada_queries.intent} IS NOT NULL`)
  .groupBy(ada_queries.intent)
  .orderBy(desc(sql`COUNT(*)`))
  .limit(5);

const aggRow = await db
  .select({
    avgLatency: sql<number | null>`AVG(${ada_queries.latency_ms})`,
    totalCostCents: sql<number | null>`COALESCE(SUM(${ada_queries.cost_cents}), 0)`,
  })
  .from(ada_queries)
  .then(r => r[0] || { avgLatency: null, totalCostCents: 0 });

const totalPages = Math.ceil(total / PAGE_SIZE);
---

<Layout title="Ada Query Log | Admin">
  <div class="flex min-h-screen bg-[#0B0B10] text-[#F2F1F7]">
    <aside class="w-64 bg-[#1A1A2E] min-h-screen p-4 shrink-0">
      <h2 class="text-xl font-bold text-[#C6FF3D] mb-6">Admin</h2>
      <nav class="space-y-1 text-sm">
        <a href="/admin/" class="block px-3 py-2 rounded hover:bg-[#2D2D44]">Dashboard</a>
        <a href="/admin/wiki" class="block px-3 py-2 rounded hover:bg-[#2D2D44]">Wiki Entries</a>
        <a href="/admin/marketplace" class="block px-3 py-2 rounded hover:bg-[#2D2D44]">Marketplace</a>
        <a href="/admin/news" class="block px-3 py-2 rounded hover:bg-[#2D2D44]">News</a>
        <a href="/admin/tasks" class="block px-3 py-2 rounded hover:bg-[#2D2D44]">Tasks</a>
        <a href="/admin/ada" class="block px-3 py-2 rounded bg-[#5B4CFF]/20 text-[#C6FF3D] font-medium">Ada Log</a>
        <a href="/admin/settings" class="block px-3 py-2 rounded hover:bg-[#2D2D44]">Settings</a>
      </nav>
    </aside>

    <main class="flex-1 p-6 lg:p-8">
      <h1 class="text-3xl font-bold mb-6">Ada Query Log</h1>

      <!-- Stats -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
        <div class="bg-[#1A1A2E] border border-[#2D2D44] p-4 rounded-lg">
          <p class="text-xs uppercase text-gray-500 mb-1">Total Queries</p>
          <p class="text-2xl font-bold text-[#C6FF3D]">{total}</p>
        </div>
        <div class="bg-[#1A1A2E] border border-[#2D2D44] p-4 rounded-lg">
          <p class="text-xs uppercase text-gray-500 mb-1">Total Cost</p>
          <p class="text-2xl font-bold text-[#C6FF3D]">${((aggRow.totalCostCents || 0) / 100).toFixed(2)}</p>
        </div>
        <div class="bg-[#1A1A2E] border border-[#2D2D44] p-4 rounded-lg">
          <p class="text-xs uppercase text-gray-500 mb-1">Avg Latency</p>
          <p class="text-2xl font-bold text-[#C6FF3D]">{aggRow.avgLatency ? Math.round(aggRow.avgLatency) : 0}ms</p>
        </div>
        <div class="bg-[#1A1A2E] border border-[#2D2D44] p-4 rounded-lg">
          <p class="text-xs uppercase text-gray-500 mb-1">Top Intent</p>
          <p class="text-2xl font-bold text-[#C6FF3D]">{topIntents[0]?.intent || '—'}</p>
        </div>
      </div>

      <!-- Top intents -->
      {topIntents.length > 0 && (
        <section class="mb-8">
          <h2 class="text-lg font-bold mb-3">Top Intents</h2>
          <div class="bg-[#1A1A2E] border border-[#2D2D44] rounded-lg p-4">
            <ul class="space-y-2">
              {topIntents.map(t => (
                <li class="flex items-center justify-between text-sm">
                  <span class="font-mono text-[#3DE0FF]">{t.intent}</span>
                  <span class="text-[#C6FF3D] font-medium">{t.c}</span>
                </li>
              ))}
            </ul>
          </div>
        </section>
      )}

      <!-- Queries table -->
      <h2 class="text-lg font-bold mb-3">All Queries ({total})</h2>
      {queries.length === 0 ? (
        <div class="bg-[#1A1A2E] border border-[#2D2D44] rounded-lg p-8 text-center text-gray-500">
          No queries yet.
        </div>
      ) : (
        <div class="bg-[#1A1A2E] border border-[#2D2D44] rounded-lg overflow-hidden">
          <table class="w-full text-sm">
            <thead class="bg-[#2D2D44]">
              <tr>
                <th class="px-4 py-2 text-left text-xs uppercase text-gray-400 w-44">When</th>
                <th class="px-4 py-2 text-left text-xs uppercase text-gray-400">Query</th>
                <th class="px-4 py-2 text-left text-xs uppercase text-gray-400 w-32">Intent</th>
                <th class="px-4 py-2 text-right text-xs uppercase text-gray-400 w-20">Cost</th>
                <th class="px-4 py-2 text-right text-xs uppercase text-gray-400 w-20">Time</th>
              </tr>
            </thead>
            <tbody>
              {queries.map(q => (
                <tr class="border-t border-[#2D2D44]">
                  <td class="px-4 py-2 text-xs text-gray-500">{q.created_at ? new Date(q.created_at).toLocaleString() : '—'}</td>
                  <td class="px-4 py-2 line-clamp-2">{q.query}</td>
                  <td class="px-4 py-2 text-xs text-[#3DE0FF]">{q.intent || '—'}</td>
                  <td class="px-4 py-2 text-right text-xs">${((q.cost_cents || 0) / 100).toFixed(4)}</td>
                  <td class="px-4 py-2 text-right text-xs">{q.latency_ms || 0}ms</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}

      <!-- Pagination -->
      {totalPages > 1 && (
        <div class="flex justify-center gap-2 mt-6">
          {page > 1 && (
            <a href={`/admin/ada?page=${page - 1}`} class="px-3 py-1 bg-[#2D2D44] rounded text-sm hover:bg-[#5B4CFF]">← Prev</a>
          )}
          <span class="px-3 py-1 text-sm text-gray-500">Page {page} of {totalPages}</span>
          {page < totalPages && (
            <a href={`/admin/ada?page=${page + 1}`} class="px-3 py-1 bg-[#2D2D44] rounded text-sm hover:bg-[#5B4CFF]">Next →</a>
          )}
        </div>
      )}
    </main>
  </div>
</Layout>
