---
import Layout from '@/layouts/Base.astro';
export const prerender = false;

import fs from 'node:fs/promises';
import path from 'node:path';

const session = Astro.locals.session;
if (!session) return Astro.redirect('/admin/login');

const tasksRoot = path.join(process.cwd(), 'vault/05-tasks');
const sections = ['active', 'backlog', 'completed'] as const;

interface Task {
  id: string;
  title: string;
  status: string;
  priority: string;
  filename: string;
}

const tasks: Record<string, Task[]> = { active: [], backlog: [], completed: [] };

for (const sec of sections) {
  const dir = path.join(tasksRoot, sec);
  try {
    const files = await fs.readdir(dir);
    for (const f of files) {
      if (!f.endsWith('.md')) continue;
      const raw = await fs.readFile(path.join(dir, f), 'utf-8');
      const idMatch = raw.match(/^id:\s*(T\d+)/m);
      const titleMatch = raw.match(/^title:\s*(.+)$/m);
      const statusMatch = raw.match(/^status:\s*(.+)$/m);
      const prioMatch = raw.match(/^priority:\s*(.+)$/m);
      tasks[sec].push({
        id: idMatch?.[1] || f.replace('.md', ''),
        title: titleMatch?.[1]?.trim().replace(/^["']|["']$/g, '') || f,
        status: statusMatch?.[1]?.trim() || '',
        priority: prioMatch?.[1]?.trim() || '',
        filename: f,
      });
    }
  } catch {}
}
---

<Layout title="Tasks | Admin">
  <div class="flex min-h-screen bg-[#0B0B10] text-[#F2F1F7]">
    <aside class="w-64 bg-[#1A1A2E] min-h-screen p-4 shrink-0">
      <h2 class="text-xl font-bold text-[#C6FF3D] mb-6">Admin</h2>
      <nav class="space-y-1 text-sm">
        <a href="/admin/" class="block px-3 py-2 rounded hover:bg-[#2D2D44]">Dashboard</a>
        <a href="/admin/wiki" class="block px-3 py-2 rounded hover:bg-[#2D2D44]">Wiki Entries</a>
        <a href="/admin/marketplace" class="block px-3 py-2 rounded hover:bg-[#2D2D44]">Marketplace</a>
        <a href="/admin/news" class="block px-3 py-2 rounded hover:bg-[#2D2D44]">News</a>
        <a href="/admin/tasks" class="block px-3 py-2 rounded bg-[#5B4CFF]/20 text-[#C6FF3D] font-medium">Tasks</a>
        <a href="/admin/ada" class="block px-3 py-2 rounded hover:bg-[#2D2D44]">Ada Log</a>
        <a href="/admin/settings" class="block px-3 py-2 rounded hover:bg-[#2D2D44]">Settings</a>
      </nav>
    </aside>

    <main class="flex-1 p-6 lg:p-8">
      <h1 class="text-3xl font-bold mb-6">Tasks (vault read-only)</h1>
      <p class="text-sm text-gray-400 mb-6">Edit tasks in the vault using scripts/task.sh. This is a view.</p>

      <div class="space-y-8">
        {sections.map(sec => (
          <section>
            <h2 class="text-lg font-bold mb-3 flex items-center gap-2">
              <span class={`w-2 h-2 rounded-full ${sec === 'active' ? 'bg-[#C6FF3D]' : sec === 'backlog' ? 'bg-[#3DE0FF]' : 'bg-gray-500'}`}></span>
              {sec.toUpperCase()}
              <span class="text-xs text-gray-500">({tasks[sec].length})</span>
            </h2>
            {tasks[sec].length === 0 ? (
              <p class="text-sm text-gray-500 pl-4">No tasks.</p>
            ) : (
              <div class="space-y-2">
                {tasks[sec].map(t => (
                  <div class="bg-[#1A1A2E] border border-[#2D2D44] rounded p-4">
                    <div class="flex items-start justify-between">
                      <div>
                        <span class="font-mono text-xs text-[#3DE0FF] mr-2">{t.id}</span>
                        <span class="text-sm font-medium">{t.title}</span>
                      </div>
                      {t.priority && (
                        <span class={`text-xs px-2 py-0.5 rounded font-medium ${
                          t.priority === 'P0' ? 'bg-red-500/20 text-red-300' :
                          t.priority === 'P1' ? 'bg-yellow-500/20 text-yellow-300' :
                          'bg-gray-500/20 text-gray-300'
                        }`}>{t.priority}</span>
                      )}
                    </div>
                  </div>
                ))}
              </div>
            )}
          </section>
        ))}
      </div>
    </main>
  </div>
</Layout>
