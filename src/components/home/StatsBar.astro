---
/**
 * StatsBar.astro — animated live-count stats
 * Numbers animate from 0 when scrolled into view.
 * Pulls live counts from content collections where possible.
 */
import { getCollection } from 'astro:content';

const wiki = await getCollection('wiki').catch(() => []);
const mkt = await getCollection('marketplace', e => e.data.status === 'live').catch(() => []);

const stats = [
  { value: wiki.length || 0,  display: wiki.length || 0,   label: 'wiki entries',      suffix: '', prefix: '' },
  { value: mkt.length || 0,   display: mkt.length || 0,    label: 'marketplace tools', suffix: '', prefix: '' },
  { value: 14382,              display: 14382,              label: 'tools indexed',     suffix: '', prefix: '' },
  { value: 94,                 display: 94,                 label: 'creator revenue',   suffix: '%', prefix: 'up to ' },
];
---

<section class="stats-bar" id="statsBar" aria-label="Platform statistics">
  <div class="stats-inner">
    {stats.map((s, i) => (
      <div class="stat" data-value={s.value} data-index={i}>
        <div class="stat-num">
          <span class="stat-prefix">{s.prefix}</span>
          <span class="stat-counter" data-target={s.value}>0</span>
          <span class="stat-suffix">{s.suffix}</span>
        </div>
        <div class="stat-label">{s.label}</div>
      </div>
    ))}
  </div>
</section>

<script>
(() => {
  function animateCounters() {
    const counters = document.querySelectorAll<HTMLElement>('.stat-counter');
    counters.forEach(el => {
      const target = parseInt(el.dataset.target || '0', 10);
      if (target === 0) { el.textContent = '0'; return; }
      const duration = 1600;
      const start = performance.now();
      function step(now: number) {
        const elapsed = now - start;
        const progress = Math.min(elapsed / duration, 1);
        // Ease out cubic
        const eased = 1 - Math.pow(1 - progress, 3);
        el.textContent = Math.floor(eased * target).toLocaleString();
        if (progress < 1) requestAnimationFrame(step);
        else el.textContent = target.toLocaleString();
      }
      requestAnimationFrame(step);
    });
  }

  function init() {
    const bar = document.getElementById('statsBar');
    if (!bar) return;
    const observer = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          animateCounters();
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.3 });
    observer.observe(bar);
  }

  document.addEventListener('astro:page-load', init);
  init();
})();
</script>

<style>
  .stats-bar {
    background: var(--surface);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 36px 36px;
  }

  .stats-inner {
    max-width: var(--max-content);
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
  }

  .stat {
    text-align: center;
    padding: 20px 16px;
    position: relative;
    opacity: 0;
    transform: translateY(10px);
    animation: statFadeIn 0.5s ease forwards;
  }
  /* Stagger via nth-child */
  .stat:nth-child(1) { animation-delay: 0.1s; }
  .stat:nth-child(2) { animation-delay: 0.2s; }
  .stat:nth-child(3) { animation-delay: 0.3s; }
  .stat:nth-child(4) { animation-delay: 0.4s; }

  @keyframes statFadeIn {
    to { opacity: 1; transform: translateY(0); }
  }

  .stat:not(:last-child)::after {
    content: '';
    position: absolute;
    right: 0; top: 20%; bottom: 20%;
    width: 1px;
    background: var(--border);
  }

  .stat-num {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 2px;
    font-family: var(--font-headline);
    font-size: clamp(28px, 4vw, 44px);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text);
    margin-bottom: 6px;
  }

  .stat-prefix {
    font-size: 0.5em;
    color: var(--muted);
    font-weight: 400;
    align-self: center;
  }

  .stat-suffix {
    color: var(--lime);
    font-size: 0.75em;
  }

  .stat-label {
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  @media (max-width: 700px) {
    .stats-inner { grid-template-columns: repeat(2, 1fr); }
    .stat:nth-child(2)::after { display: none; }
    .stat:nth-child(4)::after { display: none; }
  }
  @media (max-width: 400px) {
    .stats-inner { grid-template-columns: 1fr; }
    .stat::after { display: none; }
  }
</style>
