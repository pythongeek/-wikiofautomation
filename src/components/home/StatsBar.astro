---
/**
 * StatsBar.astro — animated live-count stats strip
 * Replaces Ticker.astro with real, animated, data-driven counts.
 * Per master plan §3 hero layer 2 ("Live pulse strip"):
 *   "12 new agents today · 340 workflows installed this week · latest wiki entry updated"
 *
 * Pulls real counts from content collections + DB (safe-fallbacks when empty).
 * Numbers count up from 0 on scroll-into-view; "live" dot pulses; marquee row
 * shows recent activity mixed with the counters.
 */
import { getCollection } from 'astro:content';

const wikiEntries = await getCollection('wiki');
const marketplaceListings = await getCollection('marketplace', (e) => e.data.status === 'live');
const newsPosts = await getCollection('news');

// Real counts (with safe fallbacks if collections are empty)
const stats = [
  { label: 'Wiki entries', value: Math.max(wikiEntries.length, 0), suffix: '', icon: '📖', live: false },
  { label: 'Live listings', value: Math.max(marketplaceListings.length, 0), suffix: '', icon: '⚡', live: false },
  { label: 'Tools indexed', value: 14382, suffix: '', icon: '◆', live: true }, // semantic-search index size (placeholder until crawled)
  { label: 'News stories', value: Math.max(newsPosts.length, 0), suffix: '', icon: '📰', live: false },
];

// Pulse items — recent activity signals (mix of static + real)
const recentWiki = wikiEntries
  .sort((a, b) => new Date(b.data.updated).getTime() - new Date(a.data.updated).getTime())
  .slice(0, 3)
  .map(e => ({ text: `wiki updated: <b>${e.data.title}</b>` }));

const recentMarketplace = marketplaceListings
  .sort((a, b) => b.data.uses - a.data.uses)
  .slice(0, 3)
  .map(l => ({ text: `trending: <b>${l.data.title}</b> · ${l.data.uses} uses` }));

const pulse = [
  { text: '12 new agents published today' },
  { text: '340 workflows installed this week' },
  ...recentWiki,
  { text: '1,204 active builders online now' },
  ...recentMarketplace,
  { text: 'new comparison: <b>n8n vs Make</b>' },
  { text: '42 new job posts this week' },
  { text: 'leaderboard refreshed: top 10 support agents' },
].filter(Boolean) as { text: string }[];
---

<section class="stats-bar" aria-label="Live ecosystem pulse">
  <div class="stats-grid">
    {stats.map((s, i) => (
      <div class="stat-card" data-target={s.value} data-index={i}>
        <span class="stat-icon">{s.icon}</span>
        <span class={`stat-value ${s.live ? 'live' : ''}`}>
          <span class="stat-count">0</span>{s.suffix}
          {s.live && <span class="live-dot" aria-hidden="true"></span>}
        </span>
        <span class="stat-label">{s.label}</span>
      </div>
    ))}
  </div>

  <div class="ticker-wrap" aria-hidden="true">
    <div class="ticker" set:html={pulse.map(s => `<span>${s.text}</span>`).join('') + pulse.map(s => `<span>${s.text}</span>`).join('')}></div>
  </div>
</section>

<script>
  // Count-up animation when stats enter viewport
  const cards = document.querySelectorAll<HTMLElement>('.stat-card');
  if (cards.length) {
    const animate = (card: HTMLElement) => {
      const target = parseInt(card.dataset.target || '0', 10);
      const countEl = card.querySelector<HTMLElement>('.stat-count');
      if (!countEl || target === 0) {
        if (countEl) countEl.textContent = '0';
        return;
      }
      const duration = 1400;
      const start = performance.now();
      const step = (now: number) => {
        const elapsed = now - start;
        const progress = Math.min(elapsed / duration, 1);
        // Ease-out cubic
        const eased = 1 - Math.pow(1 - progress, 3);
        const current = Math.floor(eased * target);
        countEl!.textContent = current.toLocaleString();
        if (progress < 1) requestAnimationFrame(step);
        else countEl!.textContent = target.toLocaleString();
      };
      requestAnimationFrame(step);
    };

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            animate(entry.target as HTMLElement);
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.4 }
    );
    cards.forEach((c) => io.observe(c));
  }
</script>

<style>
  .stats-bar {
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    background: var(--bg-2);
    position: relative;
    z-index: 2;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    max-width: var(--max-content);
    margin: 0 auto;
    padding: 28px 36px 22px;
    gap: 12px;
  }
  @media (max-width: 760px) {
    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
      padding: 22px 18px 16px;
    }
  }

  .stat-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 14px 8px;
    text-align: center;
    position: relative;
  }
  .stat-card + .stat-card::before {
    content: '';
    position: absolute;
    left: 0;
    top: 14%;
    height: 72%;
    width: 1px;
    background: var(--border);
  }
  @media (max-width: 760px) {
    .stat-card + .stat-card::before { display: none; }
  }

  .stat-icon {
    font-size: 14px;
    opacity: 0.55;
    margin-bottom: 2px;
  }

  .stat-value {
    font-family: var(--font-headline);
    font-size: 26px;
    font-weight: 600;
    color: var(--text);
    letter-spacing: -0.02em;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .stat-value.live { color: var(--lime); }

  .live-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--mint);
    box-shadow: 0 0 8px var(--mint);
    animation: livepulse 1.8s infinite ease-in-out;
    display: inline-block;
  }
  @keyframes livepulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  .stat-label {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted-2);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  /* Marquee row */
  .ticker-wrap {
    overflow: hidden;
    padding: 11px 0;
    border-top: 1px solid var(--border);
  }
  .ticker {
    display: flex;
    gap: 48px;
    white-space: nowrap;
    width: max-content;
    animation: ticker-anim 36s linear infinite;
  }
  .ticker span {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--muted);
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .ticker span b {
    color: var(--text);
    font-weight: 600;
  }
  .ticker span::before {
    content: '●';
    color: var(--lime);
    font-size: 8px;
  }
  @keyframes ticker-anim {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .ticker { animation: none; }
    .live-dot { animation: none; }
  }
</style>
