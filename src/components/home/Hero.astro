---
/**
 * Hero.astro — homepage hero with network canvas, Ada orb, eyebrow, headline, AdaBar
 * Mirrors drive-source/wiki-of-automation-homepage.html <section class="hero">
 */
import NetworkCanvas from '~/components/home/NetworkCanvas.astro';
import AdaOrb from '~/components/ada/AdaOrb.astro';
import AdaBar from '~/components/ada/AdaBar.astro';
---

<section class="hero">
  <NetworkCanvas />
  <div class="hero-vignette"></div>
  <div class="hero-content">
    <div class="eyebrow eyebrow-row">
      <span class="dot"></span>
      <span>ADA IS ONLINE · INDEXING 14,382 TOOLS</span>
    </div>

    <AdaOrb />

    <h1>
      The <span class="grad">encyclopedia</span> of automation<br>is alive.
    </h1>
    <p class="sub">
      Ask Ada anything about agents, workflows, and AI tooling — she reads the whole wiki and the whole marketplace so you don't have to.
    </p>

    <AdaBar />
  </div>

  <div class="scroll-cue">
    <span>SCROLL</span>
    <span class="line"></span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: calc(var(--nav-height) + 80px) 24px 80px;
    overflow: hidden;
  }

  .hero-vignette {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      radial-gradient(ellipse 70% 55% at 50% 38%, rgba(91, 76, 255, 0.16), transparent 60%),
      radial-gradient(ellipse 120% 60% at 50% 100%, var(--bg) 20%, transparent 70%);
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 820px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .eyebrow-row {
    margin-bottom: 22px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .eyebrow-row .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--mint);
    box-shadow: 0 0 8px var(--mint);
    animation: blink 1.8s infinite;
  }
  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  h1 {
    font-size: clamp(34px, 5.4vw, 62px);
    line-height: 1.05;
    margin-bottom: 18px;
  }
  h1 .grad {
    background: linear-gradient(90deg, var(--indigo-soft), var(--cyan));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  p.sub {
    color: var(--muted);
    font-size: 18px;
    max-width: 560px;
    margin-bottom: 52px;
    line-height: 1.55;
  }

  .scroll-cue {
    position: absolute;
    bottom: 28px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    color: var(--muted-2);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }
  .scroll-cue .line {
    width: 1px;
    height: 30px;
    background: linear-gradient(var(--muted-2), transparent);
    animation: cueflow 1.8s infinite;
  }
  @keyframes cueflow {
    0% { opacity: 0; }
    50% { opacity: 1; }
    100% { opacity: 0; }
  }
</style>
