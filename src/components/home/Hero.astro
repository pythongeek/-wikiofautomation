---
/**
 * Hero.astro v2 — full-viewport hero
 * Ada search is the hero's primary interaction.
 * NetworkCanvas provides the animated background.
 */
import NetworkCanvas from '~/components/home/NetworkCanvas.astro';
import AdaOrb from '~/components/ada/AdaOrb.astro';
import AdaBar from '~/components/ada/AdaBar.astro';
---

<section class="hero">
  <NetworkCanvas />
  <div class="hero-vignette"></div>

  <div class="hero-content">
    <!-- Eyebrow pill -->
    <div class="eyebrow-pill">
      <span class="dot"></span>
      <span>ADA IS ONLINE · INDEXING 14,382 TOOLS</span>
    </div>

    <!-- Orb -->
    <AdaOrb />

    <!-- Headline -->
    <h1>
      The <em>encyclopedia</em><br>of automation is alive.
    </h1>

    <p class="sub">
      Ask Ada anything — she reads the whole wiki, the marketplace,
      and today's launches so you don't have to.
    </p>

    <!-- Ada search bar -->
    <AdaBar />

    <!-- Intent routing chips -->
    <div class="intents">
      <button class="intent-chip" data-prompt="Find me a free lead-gen agent">
        <span class="intent-icon">🛰️</span> Find an agent
      </button>
      <button class="intent-chip" data-prompt="What is Model Context Protocol?">
        <span class="intent-icon">📚</span> Learn a concept
      </button>
      <button class="intent-chip" data-prompt="Show me trending n8n workflows this week">
        <span class="intent-icon">⚡</span> Get a workflow
      </button>
      <button class="intent-chip" data-prompt="What launched in AI automation today?">
        <span class="intent-icon">📡</span> Read today's news
      </button>
    </div>
  </div>

  <!-- Scroll cue -->
  <div class="scroll-cue" aria-hidden="true">
    <span>SCROLL</span>
    <span class="line"></span>
  </div>
</section>

<script>
(() => {
  function bind() {
    const input = document.getElementById('askField') as HTMLInputElement | null;
    if (!input) return;
    document.querySelectorAll<HTMLButtonElement>('.intent-chip').forEach(chip => {
      chip.addEventListener('click', () => {
        const prompt = chip.dataset.prompt || '';
        input.value = prompt;
        input.focus();
        // Fire the submit on AdaBar
        document.getElementById('askSend')?.click();
      });
    });
  }
  document.addEventListener('astro:page-load', bind);
  bind();
})();
</script>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: calc(var(--nav-height) + 80px) 24px 100px;
    overflow: hidden;
  }

  .hero-vignette {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      radial-gradient(ellipse 70% 55% at 50% 38%, rgba(91,76,255,0.18), transparent 65%),
      radial-gradient(ellipse 120% 50% at 50% 100%, var(--bg) 25%, transparent 70%);
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 860px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
  }

  /* Eyebrow pill */
  .eyebrow-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(91,76,255,0.12);
    border: 1px solid rgba(91,76,255,0.3);
    border-radius: var(--radius-pill);
    padding: 6px 14px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--indigo-soft);
    margin-bottom: 32px;
  }
  .eyebrow-pill .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--mint);
    box-shadow: 0 0 8px var(--mint);
    animation: blink 1.8s infinite;
  }
  @keyframes blink { 0%,100%{opacity:1;} 50%{opacity:.25;} }

  /* Headline */
  h1 {
    font-size: clamp(36px, 6vw, 68px);
    line-height: 1.04;
    letter-spacing: -0.02em;
    margin-top: 28px;
    margin-bottom: 20px;
    max-width: 780px;
  }
  h1 em {
    font-style: normal;
    background: linear-gradient(95deg, var(--indigo-soft) 0%, var(--cyan) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .sub {
    color: var(--muted);
    font-size: clamp(15px, 2vw, 18px);
    max-width: 520px;
    line-height: 1.6;
    margin-bottom: 40px;
  }

  /* Intent chips */
  .intents {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
    margin-top: 22px;
  }
  .intent-chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: rgba(20,20,29,0.7);
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    padding: 9px 16px;
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--muted);
    cursor: pointer;
    transition: all 0.2s ease;
    backdrop-filter: blur(6px);
  }
  .intent-chip:hover {
    color: var(--text);
    border-color: var(--indigo-soft);
    box-shadow: 0 0 16px rgba(91,76,255,0.2);
    transform: translateY(-1px);
  }
  .intent-chip:focus-visible {
    outline: 2px solid var(--lime);
    outline-offset: 3px;
  }
  .intent-icon { font-size: 14px; }

  /* Scroll cue */
  .scroll-cue {
    position: absolute;
    bottom: 28px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    color: var(--muted-2);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }
  .scroll-cue .line {
    width: 1px;
    height: 28px;
    background: linear-gradient(var(--muted-2), transparent);
    animation: cueflow 2s ease-in-out infinite;
  }
  @keyframes cueflow {
    0%,100% { opacity: 0; transform: scaleY(0); transform-origin: top; }
    50% { opacity: 1; transform: scaleY(1); }
  }

  @media (max-width: 640px) {
    .intents { gap: 8px; }
    .intent-chip { font-size: 12px; padding: 8px 12px; }
  }
</style>
