---
/**
 * Pillars.astro v2 — Learn / Get / Know
 * Shows live content counts from getCollection.
 */
import { getCollection } from 'astro:content';

const [wiki, mkt, news] = await Promise.all([
  getCollection('wiki').catch(() => []),
  getCollection('marketplace', e => e.data.status === 'live').catch(() => []),
  getCollection('news').catch(() => []),
]);

const pillars = [
  {
    id: 'learn',
    num: '01',
    tag: 'LEARN',
    title: 'The Wiki',
    desc: 'Wikipedia-style reference entries on every agent, framework, protocol, and model — neutral, sourced, always current.',
    cta: 'Browse the wiki',
    href: '/wiki',
    count: wiki.length,
    countLabel: 'entries',
    accentVar: '--cyan',
  },
  {
    id: 'get',
    num: '02',
    tag: 'GET',
    title: 'The Marketplace',
    desc: 'Free and paid agents, n8n workflows, AI OS stacks, and hosted mini apps. Try before you install.',
    cta: 'Explore listings',
    href: '/marketplace',
    count: mkt.length,
    countLabel: 'live listings',
    accentVar: '--lime',
  },
  {
    id: 'know',
    num: '03',
    tag: 'KNOW',
    title: 'The Newsroom',
    desc: 'Daily launches, deep dives, and benchmark leaderboards from across the automation industry.',
    cta: "Read today's news",
    href: '/news',
    count: news.length,
    countLabel: 'posts',
    accentVar: '--indigo-soft',
  },
];
---

<section class="pillars-section">
  <div class="pillars-grid">
    {pillars.map(p => (
      <article class={`pillar pillar-${p.id}`} style={`--accent: var(${p.accentVar})`}>
        <div class="pillar-glow" aria-hidden="true"></div>
        <header class="pillar-header">
          <span class="pillar-num">{p.num} — {p.tag}</span>
          {p.count > 0 && (
            <span class="pillar-count">{p.count} {p.countLabel}</span>
          )}
        </header>
        <h3>{p.title}</h3>
        <p>{p.desc}</p>
        <a class="pillar-cta" href={p.href}>
          {p.cta}
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M2 7h10M7 2l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </article>
    ))}
  </div>
</section>

<style>
  .pillars-section {
    padding: 80px 36px;
    max-width: var(--max-content);
    margin: 0 auto;
  }

  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .pillar {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 32px 28px 28px;
    position: relative;
    overflow: hidden;
    transition: border-color 0.25s, transform 0.25s, box-shadow 0.25s;
  }
  .pillar:hover {
    border-color: var(--accent);
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(0,0,0,0.3), 0 0 0 1px var(--accent);
  }

  .pillar-glow {
    position: absolute;
    width: 200px; height: 200px;
    border-radius: 50%;
    filter: blur(70px);
    opacity: 0;
    top: -80px; right: -80px;
    background: var(--accent);
    transition: opacity 0.4s;
    pointer-events: none;
  }
  .pillar:hover .pillar-glow { opacity: 0.18; }

  .pillar-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
  }

  .pillar-num {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted-2);
    letter-spacing: 0.06em;
  }

  .pillar-count {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    padding: 3px 8px;
    border-radius: var(--radius-pill);
    letter-spacing: 0.03em;
  }

  .pillar h3 {
    font-size: 24px;
    margin-bottom: 12px;
    color: var(--text);
  }

  .pillar p {
    color: var(--muted);
    font-size: 14.5px;
    line-height: 1.65;
    margin-bottom: 24px;
  }

  .pillar-cta {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
    transition: gap 0.2s;
  }
  .pillar-cta:hover { gap: 11px; }
  .pillar-cta:focus-visible { outline: 2px solid var(--lime); outline-offset: 3px; border-radius: 4px; }

  @media (max-width: 900px) {
    .pillars-grid { grid-template-columns: 1fr; }
  }
</style>
