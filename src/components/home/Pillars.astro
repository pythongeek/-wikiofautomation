---
/**
 * Pillars.astro — three-pillar grid (Learn / Get / Know) per master plan §1
 */

const pillars = [
  {
    id: 'learn',
    num: '01 — LEARN',
    title: 'The Wiki',
    desc: 'Wikipedia-style reference entries on every agent, framework, protocol, and model — neutral, sourced, always current.',
    cta: 'Browse the wiki',
    href: '/wiki',
  },
  {
    id: 'get',
    num: '02 — GET',
    title: 'The Marketplace',
    desc: 'Free and paid agents, n8n workflows, AI OS stacks, and hosted mini apps. Try before you install.',
    cta: 'Explore listings',
    href: '/marketplace',
  },
  {
    id: 'know',
    num: '03 — KNOW',
    title: 'The Newsroom',
    desc: 'Daily launches, deep dives, and benchmark leaderboards from across the automation industry.',
    cta: "Read today's news",
    href: '/news',
  },
];
---

<section id="pillars">
  <div class="pillars">
    {pillars.map(p => (
      <article class={`pillar ${p.id}`}>
        <div class="pillar-glow"></div>
        <div class="num">{p.num}</div>
        <h3>{p.title}</h3>
        <p>{p.desc}</p>
        <a class="go" href={p.href}>{p.cta} →</a>
      </article>
    ))}
  </div>
</section>

<style>
  section {
    padding: 100px 36px;
    max-width: var(--max-content);
    margin: 0 auto;
    position: relative;
  }

  .pillars {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }
  @media (max-width: 900px) {
    .pillars { grid-template-columns: 1fr; }
  }

  .pillar {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 32px 28px;
    transition: all 0.25s ease;
    position: relative;
    overflow: hidden;
  }
  .pillar:hover {
    transform: translateY(-4px);
    border-color: var(--indigo-soft);
  }
  .num {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted-2);
    margin-bottom: 18px;
  }
  .pillar h3 {
    font-size: 22px;
    margin-bottom: 10px;
  }
  .pillar p {
    color: var(--muted);
    font-size: 14.5px;
    line-height: 1.6;
    margin-bottom: 20px;
  }
  .go {
    font-size: 13px;
    font-weight: 600;
    display: inline-flex;
    gap: 6px;
    align-items: center;
  }
  .learn .go { color: var(--cyan); }
  .get .go { color: var(--lime); }
  .know .go { color: var(--indigo-soft); }

  .pillar-glow {
    position: absolute;
    width: 180px;
    height: 180px;
    border-radius: 50%;
    filter: blur(60px);
    opacity: 0.18;
    top: -60px;
    right: -60px;
  }
  .learn .pillar-glow { background: var(--cyan); }
  .get .pillar-glow { background: var(--lime); }
  .know .pillar-glow { background: var(--indigo); }
</style>
