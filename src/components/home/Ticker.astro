---
/**
 * Ticker.astro — scrolling marquee strip
 * Displays live "stats" — wiki/pulse signals. CMS-driven when populated (T005+).
 */
const stats = [
  { text: '12 new agents published today' },
  { text: '340 workflows installed this week' },
  { text: 'wiki entry updated: <b>Claude Sonnet 5</b>' },
  { text: '1,204 active builders online now' },
  { text: 'new comparison: <b>n8n vs Make</b>' },
  { text: 'trending workflow: <b>auto-reply DM triage</b>' },
  { text: '42 new job posts this week' },
  { text: 'leaderboard refreshed: top 10 support agents' },
];
---

<div class="ticker-wrap">
  <div class="ticker" id="ticker" set:html={stats.map(s => `<span>${s.text}</span>`).join('') + stats.map(s => `<span>${s.text}</span>`).join('')}>
  </div>
</div>

<style>
  .ticker-wrap {
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    background: var(--bg-2);
    overflow: hidden;
    padding: 13px 0;
    position: relative;
    z-index: 2;
  }
  .ticker {
    display: flex;
    gap: 48px;
    white-space: nowrap;
    width: max-content;
    animation: ticker-anim 32s linear infinite;
  }
  .ticker span {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--muted);
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .ticker span b {
    color: var(--text);
    font-weight: 600;
  }
  .ticker span::before {
    content: "●";
    color: var(--lime);
    font-size: 8px;
  }
  @keyframes ticker-anim {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
</style>
