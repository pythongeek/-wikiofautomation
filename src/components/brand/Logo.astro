---
/**
 * Logo.astro — Concept A (Node Mark) per master plan §2.5
 * Hexagonal lattice + lowercase 'a' for automation + page-corner accent.
 * Inlined SVG so it scales crisply and can be sized/styled via attributes.
 */
interface Props {
  size?: number;          // px (default 26)
  withWordmark?: boolean; // show "wiki of automation" alongside
}
const { size = 26, withWordmark = false } = Astro.props;
---

<span class="logo-wrap" data-size={size}>
  <svg width={size} height={size} viewBox="0 0 26 26" aria-label="wiki of automation logo">
    <circle cx="13" cy="4"  r="3" fill="#5b4cff"/>
    <circle cx="5"  cy="10" r="3" fill="#5b4cff"/>
    <circle cx="21" cy="10" r="3" fill="#5b4cff"/>
    <circle cx="5"  cy="18" r="3" fill="#5b4cff"/>
    <circle cx="21" cy="18" r="3" fill="#5b4cff"/>
    <circle cx="13" cy="23" r="3" fill="#c6ff3d"/>
    <g stroke="#5b4cff" stroke-width="1" opacity=".5">
      <line x1="13" y1="4"  x2="5"  y2="10"/>
      <line x1="13" y1="4"  x2="21" y2="10"/>
      <line x1="5"  y1="10" x2="5"  y2="18"/>
      <line x1="21" y1="10" x2="21" y2="18"/>
      <line x1="5"  y1="18" x2="13" y2="23"/>
      <line x1="21" y1="18" x2="13" y2="23"/>
    </g>
    <path d="M 13 22 L 17 25 L 13 28 Z" fill="#0a0a0f" opacity="0.35"/>
  </svg>
  {withWordmark && (
    <span class="wordmark">
      wiki <span class="of">of</span> <span class="automation">automation</span>
    </span>
  )}
</span>

<style>
  .logo-wrap {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-headline);
    font-size: 18px;
    font-weight: 600;
  }
  .of { color: var(--muted); font-weight: 400; }
  .automation { color: var(--lime); }
</style>
