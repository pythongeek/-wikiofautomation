---
/**
 * WikiSpotlight.astro — category-filtered wiki grid (replaces WikiGrid)
 * Per master plan §3 homepage layer 5 ("From the wiki"):
 *   "4–6 featured/most-read entries, styled like Wikipedia's 'Did you know?' box."
 *
 * Adds client-side category filter chips (no page reload) on top of the
 * previous grid. Categories map 1:1 to `config.ts` enum:
 *   agents · frameworks · protocols · models · companies · concepts
 *
 * All entries are rendered server-side with data-category attributes; the
 * filter chips hide/show via a tiny inline script. No hydration cost.
 */
import { getCollection, type CollectionEntry } from 'astro:content';

type Wiki = CollectionEntry<'wiki'>;

const all: Wiki[] = await getCollection('wiki');

// Sort by updated desc, take top 9 (so filter has enough density)
const entries: Wiki[] = all
  .sort((a, b) => new Date(b.data.updated).getTime() - new Date(a.data.updated).getTime())
  .slice(0, 9);

// Derive category list from data + canonical order from config.ts
const canonicalOrder = ['agents', 'frameworks', 'protocols', 'models', 'companies', 'concepts'] as const;
const presentCategories = canonicalOrder.filter((c) => entries.some((e) => e.data.category === c));

function truncate(s: string | undefined, n: number) {
  if (!s) return '';
  return s.length > n ? s.slice(0, n).trim() + '…' : s;
}
---

<section id="wiki" aria-labelledby="wiki-head">
  <header class="section-head">
    <div>
      <p class="eyebrow">FROM THE WIKI</p>
      <h2 id="wiki-head">Did you know?</h2>
    </div>
    <a class="see-all" href="/wiki">Open the full index →</a>
  </header>

  {presentCategories.length > 0 && (
    <div class="filters" role="tablist" aria-label="Wiki categories">
      <button class="filter active" data-cat="all" role="tab" aria-selected="true">All</button>
      {presentCategories.map((c) => (
        <button class="filter" data-cat={c} role="tab" aria-selected="false">{c}</button>
      ))}
    </div>
  )}

  {entries.length === 0 ? (
    <div class="empty">
      <p>The wiki is just getting started. We're seeding the highest-value entries first.</p>
      <a class="empty-cta" href="/wiki">Browse what's live →</a>
    </div>
  ) : (
    <div class="wiki-grid">
      {entries.map((entry) => (
        <a
          class="wiki-card"
          href={`/wiki/${entry.data.category}/${entry.slug}`}
          data-category={entry.data.category}
        >
          <div class="card-top">
            <span class="eyebrow-tag">{entry.data.category}</span>
            {entry.data.infobox?.kind && <span class="kind">{entry.data.infobox.kind}</span>}
          </div>
          <h4>{entry.data.title}</h4>
          <p>{truncate(entry.data.summary ?? '', 160)}</p>
          {entry.data.tags.length > 0 && (
            <div class="tags">
              {entry.data.tags.slice(0, 3).map((t) => <span class="tag">#{t}</span>)}
            </div>
          )}
        </a>
      ))}
    </div>
  )}

  {entries.length > 0 && (
    <p class="no-results" hidden>No entries in this category yet — check back soon.</p>
  )}
</section>

<script>
  const filters = document.querySelectorAll<HTMLButtonElement>('.filter');
  const cards = document.querySelectorAll<HTMLElement>('.wiki-card');
  const noResults = document.querySelector<HTMLElement>('.no-results');

  if (filters.length && cards.length) {
    filters.forEach((btn) => {
      btn.addEventListener('click', () => {
        const cat = btn.dataset.cat;
        filters.forEach((b) => {
          b.classList.remove('active');
          b.setAttribute('aria-selected', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');

        let visible = 0;
        cards.forEach((card) => {
          const show = cat === 'all' || card.dataset.category === cat;
          card.style.display = show ? '' : 'none';
          if (show) visible++;
        });
        if (noResults) noResults.hidden = visible > 0;
      });
    });
  }
</script>

<style>
  section {
    padding: 100px 36px;
    max-width: var(--max-content);
    margin: 0 auto;
    position: relative;
  }

  .section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 28px;
    flex-wrap: wrap;
    gap: 16px;
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted-2);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 8px;
  }
  .section-head h2 {
    font-size: clamp(26px, 3vw, 36px);
  }
  .see-all {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--cyan);
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-bottom: 28px;
  }
  .filter {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
    background: transparent;
    border: 1px solid var(--border);
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition: all 0.18s ease;
    text-transform: capitalize;
  }
  .filter:hover {
    color: var(--text);
    border-color: var(--muted);
  }
  .filter.active {
    color: var(--bg);
    background: var(--lime);
    border-color: var(--lime);
    font-weight: 600;
  }

  .empty {
    text-align: center;
    padding: 40px;
    color: var(--muted);
    background: var(--surface);
    border: 1px dashed var(--border);
    border-radius: var(--radius);
  }
  .empty-cta {
    display: inline-block;
    margin-top: 12px;
    color: var(--lime);
    text-decoration: underline;
  }

  .wiki-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }
  @media (max-width: 900px) {
    .wiki-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 620px) {
    .wiki-grid { grid-template-columns: 1fr; }
  }

  .wiki-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 22px;
    transition: all 0.22s ease;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .wiki-card:hover {
    border-color: var(--cyan);
    transform: translateY(-3px);
    box-shadow: 0 8px 32px rgba(61, 224, 255, 0.08);
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
  }
  .eyebrow-tag {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--cyan);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .kind {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--muted-2);
  }

  .wiki-card h4 {
    font-size: 17px;
    line-height: 1.3;
  }
  .wiki-card p {
    color: var(--muted);
    font-size: 13.5px;
    line-height: 1.6;
    flex: 1;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 6px;
  }
  .tag {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted-2);
  }

  .no-results {
    text-align: center;
    padding: 32px;
    color: var(--muted-2);
    font-family: var(--font-mono);
    font-size: 13px;
  }
</style>
