---
/**
 * WikiSpotlight.astro — Featured wiki entries with category filter.
 * Replaces WikiGrid.astro. Import as WikiSpotlight in index.astro.
 */
import { getCollection, type CollectionEntry } from 'astro:content';

type Wiki = CollectionEntry<'wiki'>;

const all = await getCollection('wiki').catch(() => [] as Wiki[]);
const sorted = all.sort((a, b) => new Date(b.data.updated).getTime() - new Date(a.data.updated).getTime());
const top = sorted.slice(0, 6);

const categories = ['all', 'agents', 'frameworks', 'protocols', 'models', 'companies', 'concepts'] as const;
const catColors: Record<string, string> = {
  agents: 'var(--lime)',
  frameworks: 'var(--cyan)',
  protocols: 'var(--indigo-soft)',
  models: 'var(--amber)',
  companies: 'var(--mint)',
  concepts: 'var(--muted)',
};

function isNew(dateStr: string) {
  const d = new Date(dateStr);
  return (Date.now() - d.getTime()) < 7 * 24 * 60 * 60 * 1000;
}
function daysAgo(dateStr: string) {
  const d = Math.floor((Date.now() - new Date(dateStr).getTime()) / (1000 * 60 * 60 * 24));
  if (d === 0) return 'today';
  if (d === 1) return '1d ago';
  return `${d}d ago`;
}
---

<section class="wiki-section" id="wiki">
  <header class="section-head">
    <div>
      <h2>From the wiki</h2>
      <p class="section-sub">{all.length} reference entries — neutral, sourced, updated.</p>
    </div>
    <a class="see-all" href="/wiki">Open full index →</a>
  </header>

  <!-- Category tabs -->
  {all.length > 0 && (
    <div class="wiki-tabs" role="tablist" aria-label="Filter wiki by category">
      {categories.map(c => (
        <button
          class={`wiki-tab ${c === 'all' ? 'active' : ''}`}
          data-cat={c}
          role="tab"
          aria-selected={c === 'all' ? 'true' : 'false'}
        >
          {c === 'all' ? 'All' : c.charAt(0).toUpperCase() + c.slice(1)}
        </button>
      ))}
    </div>
  )}

  <!-- Cards grid -->
  {top.length === 0 ? (
    <div class="wiki-empty">
      <p>Wiki seeding in progress — first entries coming soon.</p>
    </div>
  ) : (
    <div class="wiki-grid" id="wikiCards">
      {top.map(entry => (
        <a
          class="wiki-card"
          href={`/wiki/${entry.data.category}/${entry.slug}`}
          data-cat={entry.data.category}
          style={`--cat-color: ${catColors[entry.data.category] ?? 'var(--muted)'}`}
        >
          <div class="wc-top">
            <span class="wc-cat">{entry.data.category}</span>
            <div class="wc-badges">
              {isNew(entry.data.created) && <span class="badge-new">NEW</span>}
              <span class="wc-time">{daysAgo(entry.data.updated)}</span>
            </div>
          </div>
          <h4>{entry.data.title}</h4>
          <p>{entry.data.summary ?? ''}</p>
          <span class="wc-cta">Read entry →</span>
        </a>
      ))}
    </div>
  )}
</section>

<script>
(() => {
  function init() {
    const tabs = document.querySelectorAll<HTMLButtonElement>('.wiki-tab');
    const cards = document.querySelectorAll<HTMLElement>('.wiki-card');
    if (!tabs.length) return;

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => { t.classList.remove('active'); t.setAttribute('aria-selected', 'false'); });
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');

        const cat = tab.dataset.cat || 'all';
        cards.forEach(card => {
          const show = cat === 'all' || card.dataset.cat === cat;
          card.style.display = show ? 'flex' : 'none';
          if (show) {
            card.style.opacity = '0';
            requestAnimationFrame(() => {
              card.style.transition = 'opacity 0.22s ease';
              card.style.opacity = '1';
            });
          }
        });
      });
    });
  }
  document.addEventListener('astro:page-load', init);
  init();
})();
</script>

<style>
  .wiki-section {
    padding: 80px 36px;
    max-width: var(--max-content);
    margin: 0 auto;
  }

  .section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 24px;
    flex-wrap: wrap;
    gap: 16px;
  }
  .section-head h2 { font-size: clamp(24px, 3vw, 34px); }
  .section-sub { color: var(--muted); font-size: 14px; margin-top: 4px; }
  .see-all {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--cyan);
    text-decoration: none;
    white-space: nowrap;
    transition: opacity 0.15s;
  }
  .see-all:hover { opacity: 0.7; }

  /* Tabs */
  .wiki-tabs {
    display: flex;
    gap: 8px;
    margin-bottom: 22px;
    flex-wrap: wrap;
  }
  .wiki-tab {
    font-family: var(--font-mono);
    font-size: 12px;
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border);
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition: all 0.18s;
  }
  .wiki-tab:hover { color: var(--text); border-color: var(--muted); }
  .wiki-tab.active {
    background: var(--surface);
    color: var(--cyan);
    border-color: var(--cyan);
  }
  .wiki-tab:focus-visible { outline: 2px solid var(--lime); outline-offset: 2px; }

  /* Grid */
  .wiki-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .wiki-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 22px;
    text-decoration: none;
    color: inherit;
    position: relative;
    transition: border-color 0.2s, transform 0.2s;
    border-top: 2px solid var(--cat-color, var(--border));
  }
  .wiki-card:hover {
    border-color: var(--cat-color, var(--indigo-soft));
    transform: translateY(-2px);
  }
  .wiki-card:focus-visible { outline: 2px solid var(--lime); outline-offset: 2px; }

  .wc-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .wc-cat {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--cat-color, var(--muted));
  }

  .wc-badges {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .badge-new {
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--lime);
    background: rgba(198,255,61,0.12);
    padding: 2px 6px;
    border-radius: var(--radius-pill);
  }

  .wc-time {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--muted-2);
  }

  .wiki-card h4 { font-size: 16px; font-weight: 600; color: var(--text); line-height: 1.3; }
  .wiki-card p { font-size: 13px; color: var(--muted); line-height: 1.55; flex: 1; }

  .wc-cta {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--cat-color, var(--cyan));
    margin-top: auto;
    opacity: 0;
    transform: translateX(-4px);
    transition: all 0.2s;
  }
  .wiki-card:hover .wc-cta { opacity: 1; transform: translateX(0); }

  .wiki-empty {
    text-align: center;
    padding: 48px;
    color: var(--muted);
    background: var(--surface);
    border: 1px dashed var(--border);
    border-radius: var(--radius);
  }

  @media (max-width: 900px) { .wiki-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 580px) { .wiki-grid { grid-template-columns: 1fr; } }
</style>
