---
/**
 * Footer.astro — 5-column footer from Drive HTML §4
 */
import Logo from '~/components/brand/Logo.astro';
const year = new Date().getFullYear();
---

<footer>
  <div class="foot-grid">
    <div class="foot-col">
      <Logo size={26} withWordmark />
      <p>The encyclopedia of automation — understand it, find it, ship it.</p>
    </div>
    <div class="foot-col">
      <h5>Wiki</h5>
      <a href="/wiki/agents">Agents</a>
      <a href="/wiki/frameworks">Frameworks</a>
      <a href="/wiki/protocols">Protocols</a>
      <a href="/wiki/glossary">Glossary</a>
    </div>
    <div class="foot-col">
      <h5>Marketplace</h5>
      <a href="/marketplace/agents">Agents</a>
      <a href="/marketplace/workflows">Workflows</a>
      <a href="/marketplace/ai-os">AI OS</a>
      <a href="/marketplace/apps">Apps</a>
    </div>
    <div class="foot-col">
      <h5>Company</h5>
      <a href="/about">About</a>
      <a href="/newsletter">Newsletter</a>
      <a href="/jobs">Jobs board</a>
      <a href="/changelog">Changelog</a>
    </div>
    <div class="foot-col">
      <h5>Language</h5>
      <a href="/" hreflang="en">English</a>
      <a href="/bn/" hreflang="bn">বাংলা</a>
      <a href="/hi/" hreflang="hi">हिंदी</a>
    </div>
  </div>
  <div class="foot-bottom">
    <span>© {year} wiki of automation</span>
    <span>Made with ♥ in Bangladesh</span>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--border);
    padding: 60px 36px 30px;
    color: var(--muted-2);
    font-size: 13px;
    background: var(--bg);
  }

  .foot-grid {
    max-width: var(--max-content);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.4fr repeat(4, 1fr);
    gap: 30px;
    margin-bottom: 50px;
  }

  .foot-col h5 {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
    margin-bottom: 14px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .foot-col a {
    display: block;
    color: var(--muted-2);
    font-size: 13.5px;
    margin-bottom: 10px;
    transition: color 0.15s ease;
  }
  .foot-col a:hover { color: var(--text); }

  .foot-col p {
    color: var(--muted-2);
    font-size: 13px;
    max-width: 240px;
    margin-top: 10px;
  }

  .foot-bottom {
    max-width: var(--max-content);
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    border-top: 1px solid var(--border);
    padding-top: 24px;
  }

  @media (max-width: 900px) {
    .foot-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
