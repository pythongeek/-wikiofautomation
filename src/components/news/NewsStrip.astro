---
/**
 * NewsStrip.astro — recent news on homepage
 */
import { getCollection, type CollectionEntry } from 'astro:content';

type News = CollectionEntry<'news'>;

const all = await getCollection('news');
const top: News[] = all
  .sort((a: News, b: News) => new Date(b.data.published).getTime() - new Date(a.data.published).getTime())
  .slice(0, 4);

function relativeTime(iso: string) {
  const then = new Date(iso).getTime();
  const now = Date.now();
  const mins = Math.round((now - then) / 60000);
  if (mins < 60) return `${Math.max(1, mins)}h ago`;
  const hours = Math.round(mins / 60);
  if (hours < 24) return `${hours}h ago`;
  return `${Math.round(hours / 24)}d ago`;
}
---

<section id="news">
  <header class="section-head">
    <h2>Today in automation</h2>
    <a class="see-all" href="/news">All news →</a>
  </header>

  {top.length === 0 ? (
    <div class="empty">
      <p>Newsroom launching soon — daily automation launches, deep dives, and benchmarks.</p>
    </div>
  ) : (
    <div class="news-list">
      {top.map(post => (
        <a class="news-item" href={`/news/${post.slug}`}>
          <span class="tag">{post.data.kind.toUpperCase()}</span>
          <span class="headline">{post.data.title}</span>
          <span class="time">{relativeTime(post.data.published)}</span>
        </a>
      ))}
    </div>
  )}
</section>

<style>
  section {
    padding: 100px 36px;
    max-width: var(--max-content);
    margin: 0 auto;
    position: relative;
  }
  .section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 44px;
    flex-wrap: wrap;
    gap: 16px;
  }
  .section-head h2 {
    font-size: clamp(26px, 3vw, 36px);
  }
  .see-all {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--cyan);
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .empty {
    text-align: center;
    padding: 40px;
    color: var(--muted);
    background: var(--surface);
    border: 1px dashed var(--border);
    border-radius: var(--radius);
  }

  .news-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border);
  }
  .news-item {
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 20px 4px;
    border-bottom: 1px solid var(--border);
    transition: all 0.2s ease;
    color: inherit;
  }
  .news-item:hover { background: var(--surface); }
  .tag {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--indigo-soft);
    width: 110px;
    flex-shrink: 0;
  }
  .headline { flex: 1; font-size: 15.5px; }
  .time {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted-2);
    flex-shrink: 0;
  }

  @media (max-width: 700px) {
    .tag { display: none; }
  }
</style>
