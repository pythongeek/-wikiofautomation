---
/**
 * AdaOrb.astro — central glowing orb in the hero
 * Mirrors Drive HTML `.orb-wrap` exactly
 */
---

<div class="orb-wrap" id="orbWrap">
  <div class="orb-ring"></div>
  <div class="orb-ring r2"></div>
  <div class="orb"></div>
  <div class="orb-bars" id="orbBars"></div>
</div>

<script>
(() => {
  const bars = document.getElementById('orbBars');
  if (bars && !bars.children.length) {
    for (let i = 0; i < 9; i++) {
      const bar = document.createElement('span');
      bar.style.animationDelay = `${i * 0.11}s`;
      bars.appendChild(bar);
    }
  }

  const wrap = document.getElementById('orbWrap');
  const input = document.getElementById('askField') as HTMLInputElement | null;

  function bindListening() {
    if (!wrap || !input) return;
    input.addEventListener('focus', () => wrap.classList.add('listening'));
    input.addEventListener('blur', () => wrap.classList.remove('listening'));
  }

  document.addEventListener('astro:page-load', bindListening);
  bindListening();
})();
</script>

<style>
  .orb-wrap {
    position: relative;
    width: 180px;
    height: 180px;
    margin-bottom: 34px;
  }

  .orb-ring {
    position: absolute;
    inset: -26px;
    border-radius: 50%;
    border: 1px solid rgba(139, 125, 255, 0.25);
    animation: spin 18s linear infinite;
  }
  .orb-ring.r2 {
    inset: -46px;
    border-color: rgba(61, 224, 255, 0.15);
    animation-duration: 26s;
    animation-direction: reverse;
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .orb {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: conic-gradient(from 0deg, var(--indigo), var(--cyan), var(--lime), var(--indigo));
    filter: blur(0.3px);
    animation: orbspin 7s linear infinite, breathe 4.2s ease-in-out infinite;
    box-shadow: 0 0 60px rgba(91, 76, 255, 0.45), 0 0 120px rgba(61, 224, 255, 0.15);
  }
  .orb::after {
    content: "";
    position: absolute;
    inset: 10px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, rgba(255, 255, 255, 0.9), rgba(20, 20, 29, 0.95) 55%);
  }

  @keyframes orbspin { to { transform: rotate(360deg); } }
  @keyframes breathe {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.045); }
  }

  .orb-wrap.listening .orb {
    animation-duration: 2.2s, 1.1s;
    box-shadow: 0 0 90px rgba(198, 255, 61, 0.55), 0 0 160px rgba(61, 224, 255, 0.25);
  }
  .orb-wrap.listening .orb-ring { animation-duration: 6s; }
  .orb-wrap.listening .orb-ring.r2 { animation-duration: 9s; }

  .orb-bars {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3px;
    z-index: 3;
  }
  .orb-bars span {
    display: block;
    width: 2.5px;
    height: 10px;
    border-radius: 2px;
    background: var(--text);
    opacity: 0.85;
    animation: barpulse 1.4s ease-in-out infinite;
  }
  @keyframes barpulse {
    0%, 100% { height: 6px; }
    50% { height: 26px; }
  }
</style>
