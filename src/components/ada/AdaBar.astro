---
/**
 * AdaBar.astro v2
 * - Real-time suggestions dropdown (debounced, min 2 chars)
 * - Intent-label on reply header
 * - Keyboard nav: Escape closes suggestions
 */
const placeholders = [
  'Ask Ada anything…',
  'What is Model Context Protocol?',
  'Find a free Slack automation agent…',
  'Compare n8n vs Zapier…',
  'What shipped in AI this week?',
  'Best agent framework for Python?',
];
---

<div class="ada-wrap" id="adaWrap">
  <!-- Search input row -->
  <div class="ada-input" id="adaInput">
    <span class="caret" aria-hidden="true">›</span>
    <input
      id="askField"
      type="text"
      autocomplete="off"
      aria-label="Ask Ada anything about automation"
      aria-expanded="false"
      aria-autocomplete="list"
      aria-controls="adaSuggestions"
      role="combobox"
    >
    <button class="ada-send" id="askSend" aria-label="Send question" type="button">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
        <path d="M8 13V3M3 8l5-5 5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </div>

  <!-- Suggestions dropdown -->
  <div class="ada-suggestions" id="adaSuggestions" role="listbox" hidden>
    <!-- Populated by JS -->
  </div>

  <!-- Reply card -->
  <div class="ada-reply" id="adaReply" hidden role="region" aria-live="polite" aria-label="Ada's answer">
    <!-- Populated by JS -->
  </div>
</div>

<script is:inline define:vars={{ placeholders }}>
(() => {
  const wrap = document.getElementById('adaWrap');
  const input = document.getElementById('askField');
  const send = document.getElementById('askSend');
  const replyEl = document.getElementById('adaReply');
  const suggestEl = document.getElementById('adaSuggestions');
  const adaInput = document.getElementById('adaInput');
  if (!wrap || !input || !send || !replyEl || !suggestEl || !adaInput) return;

  // ── Typewriter placeholder ──────────────────────────────────────────
  let pi = 0, ci = 0, del = false;
  function typeLoop() {
    if (document.activeElement === input) { setTimeout(typeLoop, 600); return; }
    const full = placeholders[pi];
    input.setAttribute('placeholder', full.slice(0, ci));
    if (!del) {
      ci++;
      if (ci > full.length) { del = true; setTimeout(typeLoop, 1600); return; }
    } else {
      ci--;
      if (ci < 0) { del = false; pi = (pi + 1) % placeholders.length; ci = 0; }
    }
    setTimeout(typeLoop, del ? 22 : 52);
  }
  typeLoop();

  // ── Suggestions ────────────────────────────────────────────────────
  const QUICK = [
    { q: 'What is MCP?', hint: 'Model Context Protocol overview' },
    { q: 'Best free agents for email automation', hint: 'Marketplace picks' },
    { q: 'n8n vs Make vs Zapier comparison', hint: 'Wiki comparison page' },
    { q: 'How does RAG work?', hint: 'Concepts — wiki entry' },
    { q: 'Latest AI automation launches', hint: 'Newsroom digest' },
    { q: 'Publish my own agent', hint: 'Marketplace creator guide' },
  ];

  let debounceTimer = null;
  input.addEventListener('input', () => {
    clearTimeout(debounceTimer);
    const q = input.value.trim();
    if (q.length < 2) { hideSuggestions(); return; }
    debounceTimer = setTimeout(() => showSuggestions(q), 160);
  });

  function showSuggestions(q) {
    const lq = q.toLowerCase();
    const matches = QUICK.filter(s => s.q.toLowerCase().includes(lq) || s.hint.toLowerCase().includes(lq)).slice(0, 3);
    if (!matches.length) { hideSuggestions(); return; }
    suggestEl.innerHTML = matches.map((s, i) =>
      `<div class="sug-item" role="option" tabindex="0" data-q="${escape(s.q)}">
        <span class="sug-q">${s.q}</span>
        <span class="sug-hint">${s.hint}</span>
      </div>`
    ).join('');
    suggestEl.hidden = false;
    input.setAttribute('aria-expanded', 'true');
    suggestEl.querySelectorAll('.sug-item').forEach(item => {
      item.addEventListener('click', () => {
        input.value = unescape(item.dataset.q || '');
        hideSuggestions();
        doSubmit();
      });
      item.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') { item.click(); }
      });
    });
  }

  function hideSuggestions() {
    suggestEl.hidden = true;
    input.setAttribute('aria-expanded', 'false');
    suggestEl.innerHTML = '';
  }

  // Close on outside click
  document.addEventListener('click', e => {
    if (!wrap.contains(e.target)) hideSuggestions();
  });

  // Escape key
  input.addEventListener('keydown', e => {
    if (e.key === 'Escape') hideSuggestions();
    if (e.key === 'Enter') { e.preventDefault(); hideSuggestions(); doSubmit(); }
  });

  // Active state
  input.addEventListener('focus', () => adaInput.classList.add('active'));
  input.addEventListener('blur', () => adaInput.classList.remove('active'));

  // ── Submit ──────────────────────────────────────────────────────────
  send.addEventListener('click', doSubmit);

  async function doSubmit() {
    const q = (input.value || '').trim();
    if (!q) return;
    hideSuggestions();
    replyEl.hidden = false;
    replyEl.innerHTML = renderSkeleton();
    replyEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

    try {
      const res = await fetch('/api/ada', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ message: q }),
      });
      let data = null;
      if (res.ok) {
        data = await res.json();
      } else {
        data = await clientAdaBarFallback(q);
      }

      if (!data || data.error) {
        replyEl.innerHTML = renderError(data?.error || 'Ada couldn\'t reach the knowledge base. Try again in a moment.');
        return;
      }
      replyEl.innerHTML = renderReply(data, q);
    } catch {
      try {
        const fallbackData = await clientAdaBarFallback(q);
        replyEl.innerHTML = renderReply(fallbackData, q);
      } catch {
        replyEl.innerHTML = renderError('Network error — check your connection and try again.');
      }
    }
  }

  async function clientAdaBarFallback(query) {
    const apiKey = import.meta.env.PUBLIC_MINIMAX_API_KEY || import.meta.env.MINIMAX_API_KEY;
    const baseUrl = (import.meta.env.PUBLIC_MINIMAX_BASE_URL || 'https://api.minimax.io/v1').replace(/\/+$/, '');
    const rawModel = import.meta.env.PUBLIC_MINIMAX_MODEL || 'MiniMax-M3';
    const model = rawModel.replace(/^minimax\//i, '');

    if (!apiKey) {
      return {
        reply: "Ada AI is online! Connect MiniMax API key in settings or environment to enable live dynamic queries.",
        links: [{ url: '/wiki', anchor: 'Browse Encyclopedia' }, { url: '/marketplace', anchor: 'Marketplace' }]
      };
    }

    const endpoint = baseUrl.endsWith('/chat/completions') ? baseUrl : `${baseUrl}/chat/completions`;

    const res = await fetch(endpoint, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        Authorization: `Bearer ${apiKey}`,
      },
      body: JSON.stringify({
        model: model,
        temperature: 0.3,
        max_tokens: 600,
        messages: [
          { role: 'system', content: 'You are Ada, the AI assistant for Wiki of Automation (wikiofautomation.com). Answer user questions about automation, AI agents, n8n, MCP, and workflows concisely with helpful links.' },
          { role: 'user', content: query },
        ],
      }),
    });

    if (!res.ok) {
      throw new Error(`MiniMax API returned ${res.status}`);
    }

    const json = await res.json();
    let text = json.choices?.[0]?.message?.content || 'No answer generated.';
    text = text.replace(/^```(?:markdown)?/i, '').replace(/```$/, '').trim();

    return {
      reply: text,
      links: [
        { url: '/wiki', anchor: 'Encyclopedia' },
        { url: '/marketplace', anchor: 'Marketplace' }
      ]
    };
  }

  // ── Render helpers ──────────────────────────────────────────────────
  function esc(s) {
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  function renderSkeleton() {
    return `<div class="reply-inner loading">
      <div class="reply-meta"><span class="reply-badge">ADA</span><span class="reply-thinking">thinking…</span></div>
      <div class="skel-line" style="width:88%"></div>
      <div class="skel-line" style="width:72%"></div>
      <div class="skel-line" style="width:60%"></div>
    </div>`;
  }

  function renderError(msg) {
    return `<div class="reply-inner error">
      <div class="reply-meta"><span class="reply-badge error-badge">ADA</span></div>
      <p>${esc(msg)}</p>
    </div>`;
  }

  function renderReply(d, q) {
    const intent = (d.intent || 'general').toUpperCase();
    const links = (d.links || []).filter((l, i, arr) => arr.findIndex(x => x.url === l.url) === i).slice(0, 4);
    const linkChips = links.length
      ? `<div class="reply-links">${links.map(l =>
          `<a class="reply-chip" href="${esc(l.url)}">${esc(l.anchor || l.url)}</a>`
        ).join('')}</div>` : '';
    return `<div class="reply-inner">
      <div class="reply-meta">
        <span class="reply-badge">ADA</span>
        <span class="reply-intent">${esc(intent)}</span>
      </div>
      <p class="reply-text">${esc(d.reply || '')}</p>
      ${linkChips}
    </div>`;
  }

  // Expose submit globally so Hero intent chips can call it
  window.__adaSubmit = doSubmit;
})();
</script>

<style>
  .ada-wrap {
    width: 100%;
    max-width: 660px;
    position: relative;
    z-index: 10;
  }

  /* ── Input row ── */
  .ada-input {
    display: flex;
    align-items: center;
    gap: 10px;
    background: rgba(20,20,29,0.82);
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    padding: 8px 8px 8px 22px;
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .ada-input.active {
    border-color: var(--indigo-soft);
    box-shadow: 0 0 0 4px rgba(91,76,255,0.14), 0 0 36px rgba(61,224,255,0.10);
  }

  .caret {
    color: var(--muted-2);
    font-family: var(--font-mono);
    font-size: 18px;
    line-height: 1;
    flex-shrink: 0;
  }

  #askField {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    color: var(--text);
    font-family: var(--font-body);
    font-size: 15.5px;
    padding: 10px 0;
    min-width: 0;
  }
  #askField::placeholder { color: var(--muted-2); }

  .ada-send {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: none;
    background: var(--lime);
    color: var(--bg);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
    transition: all 0.2s ease;
  }
  .ada-send:hover { box-shadow: 0 0 20px rgba(198,255,61,0.55); transform: scale(1.06); }
  .ada-send:focus-visible { outline: 2px solid var(--lime); outline-offset: 3px; }

  /* ── Suggestions ── */
  .ada-suggestions {
    position: absolute;
    top: calc(100% + 8px);
    left: 0; right: 0;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    z-index: 50;
    box-shadow: 0 16px 40px rgba(0,0,0,0.4);
  }

  .sug-item {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 12px 18px;
    cursor: pointer;
    transition: background 0.15s;
    border-bottom: 1px solid var(--border);
  }
  .sug-item:last-child { border-bottom: none; }
  .sug-item:hover, .sug-item:focus { background: rgba(91,76,255,0.1); outline: none; }
  .sug-q { font-size: 14px; color: var(--text); }
  .sug-hint { font-size: 12px; color: var(--muted); font-family: var(--font-mono); }

  /* ── Reply card ── */
  .ada-reply {
    margin-top: 14px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .reply-inner {
    padding: 18px 22px;
  }
  .reply-inner.loading { opacity: 0.7; }
  .reply-inner.error { border-left: 3px solid var(--amber); }

  .reply-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
  }

  .reply-badge {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    background: var(--lime);
    color: var(--bg);
    padding: 3px 8px;
    border-radius: var(--radius-pill);
    font-weight: 700;
  }
  .error-badge { background: var(--amber); }

  .reply-intent {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--indigo-soft);
    letter-spacing: 0.1em;
  }

  .reply-thinking {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
    animation: blink 1.2s infinite;
  }
  @keyframes blink { 0%,100%{opacity:1;} 50%{opacity:0.3;} }

  .reply-text {
    font-size: 14.5px;
    line-height: 1.65;
    color: var(--text);
    margin-bottom: 14px;
  }

  .reply-links {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }

  .reply-chip {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--cyan);
    border: 1px solid var(--border);
    padding: 5px 11px;
    border-radius: var(--radius-pill);
    transition: all 0.15s;
    text-decoration: none;
  }
  .reply-chip:hover {
    border-color: var(--cyan);
    background: rgba(61,224,255,0.08);
  }

  /* Skeleton loader */
  .skel-line {
    height: 12px;
    background: linear-gradient(90deg, var(--border) 25%, rgba(91,76,255,0.15) 50%, var(--border) 75%);
    background-size: 200% 100%;
    border-radius: 6px;
    margin-bottom: 10px;
    animation: shimmer 1.4s infinite;
  }
  @keyframes shimmer {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }

  @media (max-width: 640px) {
    #askField { font-size: 14px; }
  }
</style>
